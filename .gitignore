**/config/local.yaml
**/config/*.local.yaml

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Linux deploy artifacts (binary, hash.txt, site/) staged by the deploy
# chains in docs/dev-server.md, docs/staging.md and docs/production.md
# before upload.
dist/

# Secrets per environment (JWT_SECRET, MAILER_*): secrets.dev-server.env,
# secrets.staging.env and secrets.production.env in the repo root, uploaded
# by every deploy as secrets.env (docs/dev-server.md, docs/staging.md,
# docs/production.md). Never in git.
secrets.env
secrets.*.env
*.secrets.env

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.sqlite
*.sqlite-*
*.db

# macOS Finder metadata; anything under public/ ships to the server
.DS_Store

# Claude Code's per-person settings. The shared ones, .claude/skills/ and
# CLAUDE.md, are committed.
.claude/settings.local.json