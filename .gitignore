**/config/local.yaml
**/config/*.local.yaml

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Linux deploy artifacts (binary, hash.txt, site/) staged by the pipeline
# in DEPLOYMENT.md before upload.
dist/

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.sqlite
*.sqlite-*
*.db

# macOS Finder metadata; anything under public/ ships to the server
.DS_Store